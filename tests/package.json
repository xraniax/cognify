{
  "name": "cognify-e2e-tests",
  "version": "1.0.0",
  "description": "Selenium WebDriver E2E test suite for the Cognify adaptive e-learning platform",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test:auth": "mocha \"selenium/auth/*.test.js\" --timeout 60000 --reporter spec",
    "test:materials": "mocha \"selenium/materials/*.test.js\" --timeout 120000 --reporter spec",
    "test:summaries": "mocha \"selenium/summaries/*.test.js\" --timeout 180000 --reporter spec",
    "test:plans": "mocha \"selenium/studyPlans/*.test.js\" --timeout 180000 --reporter spec",
    "test:quizzes": "mocha \"selenium/quizzes/*.test.js\" --timeout 180000 --reporter spec",
    "test:exams": "mocha \"selenium/mockExams/*.test.js\" --timeout 240000 --reporter spec",
    "test:analytics": "mocha \"selenium/analytics/*.test.js\" --timeout 120000 --reporter spec",
    "test:integration": "mocha \"selenium/integration/*.test.js\" --timeout 600000 --reporter spec",
    "test:all": "mocha \"selenium/**/*.test.js\" --timeout 600000 --reporter spec --exit"
  },
  "dependencies": {
    "selenium-webdriver": "^4.21.0"
  },
  "devDependencies": {
    "chromedriver": "148.0.4",
    "mocha": "^10.4.0"
  }
}
